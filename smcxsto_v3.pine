//@version=6
indicator("SMCxSTO V3.0", shorttitle="SMCxSTO V3.0", overlay=true, max_boxes_count=100, max_lines_count=300, max_labels_count=300)

//──────────────────────────────────────────────────────────────────────────────
// Inputs
//──────────────────────────────────────────────────────────────────────────────
string G_TF = "◉ TIMEFRAME"
string trendTf = input.timeframe("15", "TF เทรนด์ (EMA + ATR)", group=G_TF)
string obTf = input.timeframe("5", "TF หา OB", group=G_TF)
string stoTf = input.timeframe("1", "TF ของ Stochastic", group=G_TF)
bool allowLowerSto = input.bool(true, "ยอมให้ STO ใช้ TF ต่ำกว่าชาร์ต", group=G_TF,
 tooltip="เปิดไว้ตามภาพ แต่เพื่อไม่ให้พลาด intrabar แนะนำให้เปิดกราฟที่ TF เดียวกับ STO")

string G_EMA = "◉ ตัวกรองเทรนด์ (EMA)"
bool useTrend = input.bool(true, "เปิดตัวกรองเทรนด์", group=G_EMA)
int slowLen = input.int(200, "ความยาว EMA ช้า", minval=2, group=G_EMA)
int fastLen = input.int(50, "ความยาว EMA เร็ว", minval=1, group=G_EMA)
bool confirmedTrend = input.bool(true, "ใช้เฉพาะแท่งที่ปิดแล้ว (กัน repaint)", group=G_EMA)
bool showSlow = input.bool(true, "วาดเส้น EMA ช้า", inline="slow", group=G_EMA)
color slowColor = input.color(color.black, "", inline="slow", group=G_EMA)
bool showFast = input.bool(true, "วาดเส้น EMA เร็ว", inline="fast", group=G_EMA)
color fastColor = input.color(color.gray, "", inline="fast", group=G_EMA)

string G_ATR = "◉ ตัวกรองระยะยืด (ATR)"
bool useAtr = input.bool(true, "เปิดตัวกรอง ATR", group=G_ATR)
int atrLen = input.int(14, "ATR Period", minval=1, group=G_ATR)
float maxAtrDistance = input.float(2.5, "ระยะห่างสูงสุด ราคา-EMA เร็ว (x ATR)", minval=0, step=0.1, group=G_ATR,
 tooltip="ตามภาพ = 2.5; หลักสูตรชุด M15/M5/M1 ใช้ 3.0 และชุด H1/M15/M5 ใช้ 2.0")
string atrDirection = input.string("เฉพาะฝั่งเทรนด์", "กรองทิศทางไหน",
 options=["เฉพาะฝั่งเทรนด์", "ทั้งสองฝั่ง"], group=G_ATR)

string G_OB = "◉ การหา OB"
bool criterion1On = input.bool(true, "เกณฑ์ 1: แท่งสีตรงข้ามตัวสุดท้ายที่ส่งราคาไปสีเดียวกันติดต่อกัน", group=G_OB)
int runBars = input.int(2, ">=", minval=2, maxval=10, inline="run", group=G_OB)
bool criterion2On = input.bool(true, "เกณฑ์ 2: แท่งที่ติดกับ Imbalance (FVG)", group=G_OB)
float minFvgAtr = input.float(0.15, "ขนาด FVG ขั้นต่ำ (x ATR, 0=ไม่กรอง)", minval=0, step=0.05, group=G_OB)
float fvgTolerance = input.float(0.1, "FVG tolerance (x ATR)", minval=0, step=0.05, group=G_OB)
float swingTolerance = input.float(0.1, "Swing tolerance (x ATR)", minval=0, step=0.05, group=G_OB)
bool includeFvg = input.bool(true, "ขยายกรอบโซนให้คลุม FVG ด้วย (ถ้าเข้าเกณฑ์ 2)", group=G_OB)
bool breakerOn = input.bool(false, "เปิด Breaker Block (BB) — แปลง OB ที่ถูกทะลุเป็นโซนทิศตรงข้าม", group=G_OB)
bool breakerFvgOnly = input.bool(true, "BB ต้องมาจาก OB ที่มี FVG (เกณฑ์ 2) เท่านั้น", group=G_OB)
bool requireSwing = input.bool(true, "เกณฑ์ 3: แท่ง OB ต้องเป็น Swing High/Low", group=G_OB)
int swingL = input.int(5, "L", minval=1, maxval=20, inline="swing", group=G_OB)
int swingR = input.int(5, "R", minval=2, maxval=20, inline="swing", group=G_OB)
bool requireImpulse = input.bool(false, "เกณฑ์ 4: บังคับต้องมีบาร์แรงตามหลัง (ใช้ค่า x ATR จากด้านล่าง)", group=G_OB)
int obLookback = input.int(20, "ย้อนหาแท่ง OB ไม่เกินกี่แท่ง", minval=2, maxval=100, group=G_OB)
bool tagRange = input.bool(true, "แท็กเสริม: ช่วงแรงกว่าปกติ ≥ x ATR", inline="range", group=G_OB)
float impulseAtr = input.float(1.0, "", minval=0.1, step=0.1, inline="range", group=G_OB)
bool tagVolume = input.bool(true, "แท็กเสริม: Volume แท่ง OB สูงกว่าค่าเฉลี่ย SMA", inline="volume", group=G_OB)
int volumeLen = input.int(20, "", minval=1, inline="volume", group=G_OB)
float volumeFactor = input.float(1.2, "X เฉลี่ย", minval=0, step=0.1, group=G_OB)

string G_SIZE = "◉ ขนาดโซนขั้นต่ำ"
float minZoneAtr = input.float(0.5, "ความสูงกรอบโซนขั้นต่ำ (x ATR, 0=ปิด)", minval=0, step=0.1, group=G_SIZE)
string smallZoneAction = input.string("ตัดทิ้ง", "ถ้ากรอบเล็กกว่าขั้นต่ำ", options=["ตัดทิ้ง", "ขยายให้ถึงขั้นต่ำ"], group=G_SIZE)
float minZoneSpacing = input.float(0.8, "ห้ามโซนซ้อน: ระยะห่างขั้นต่ำ (x ATR, 0=ปิด)", minval=0, step=0.1, group=G_SIZE)

string G_STO = "◉ STOCHASTIC TRIGGER"
bool requireSto = input.bool(true, "ต้องรอ STO ยืนยันก่อนยิงสัญญาณ", group=G_STO)
bool realtimeSto = input.bool(false, "STO ค่าเรียลไทม์ (ไม่รอแท่ง STO ปิด)", group=G_STO)
int kLen = input.int(5, "%K Length", minval=1, inline="sto", group=G_STO)
int kSmooth = input.int(3, "Smooth %K", minval=1, inline="sto", group=G_STO)
int dLen = input.int(3, "%D", minval=1, inline="sto", group=G_STO)
float oversold = input.float(30, "ขายมากเกินไป", minval=0, maxval=50, inline="levels", group=G_STO)
float overbought = input.float(70, "ซื้อมากเกินไป", minval=50, maxval=100, inline="levels", group=G_STO,
 tooltip="ตามภาพ = 30/70; ค่ามาตรฐานหลักสูตร = 20/80")
string triggerMode = input.string("ทั้งสองอย่าง", "เงื่อนไข trigger",
 options=["ทั้งสองอย่าง", "เส้นตัดเท่านั้น", "ออกจากเขตเท่านั้น"], group=G_STO)
string armedMode = input.string("ตลอดเวลาที่อยู่ในโซน", "นับว่า armed เมื่อไหร่",
 options=["ตลอดเวลาที่อยู่ในโซน", "เมื่อ STO เข้าเขต"], group=G_STO)
int armedAfterExit = input.int(12, "หลังออกจากโซนแล้ว ยัง armed ต่อได้กี่แท่ง", minval=0, group=G_STO)
int signalCooldown = input.int(15, "เว้นระยะขั้นต่ำระหว่างสัญญาณ (แท่ง)", minval=0, group=G_STO)
bool signalMustBeInZone = input.bool(true, "ตอน STO ยืนยัน ราคาต้องยังอยู่ในโซน", group=G_STO)
float signalZoneTolerance = input.float(1.0, "ระยะผ่อนผันจากขอบโซน (x ATR ของ TF หา OB, 0=เข้มสุด)", minval=0, step=0.1, group=G_STO)

string G_LINES = "◉ เส้น ENTRY / TP / SL"
bool showTradeLines = input.bool(true, "แสดงเส้น Entry/TP/SL เมื่อเกิดสัญญาณ", group=G_LINES)
float slBufferAtr = input.float(0.3, "SL buffer จากขอบโซน (x ATR ของ TF หา OB)", minval=0, step=0.1, group=G_LINES)
float rr = input.float(2.5, "อัตราส่วน RR (คำนวณเส้น TP)", minval=0.1, step=0.1, group=G_LINES)
int tradeLineLength = input.int(25, "ความยาวเส้นไปทางขวา (แท่ง)", minval=1, maxval=500, group=G_LINES)
bool showPriceLabels = input.bool(true, "แสดงป้ายราคาที่ปลายเส้น", group=G_LINES)
color entryColor = input.color(color.rgb(39, 91, 230), "Entry", inline="linecolors", group=G_LINES)
color tpColor = input.color(color.rgb(70, 170, 80), "TP", inline="linecolors", group=G_LINES)
color slColor = input.color(color.rgb(240, 45, 70), "SL", inline="linecolors", group=G_LINES)
string priceLabelSize = input.string("เล็ก", "ขนาดป้ายราคา", options=["จิ๋ว", "เล็ก", "ปกติ"], group=G_LINES)
string priceLabelPosition = input.string("ปลายเส้น", "ตำแหน่งป้าย", options=["ปลายเส้น", "ต้นเส้น"], group=G_LINES)
string priceLabelStyle = input.string("มีกรอบสี", "รูปแบบป้าย", options=["มีกรอบสี", "ข้อความล้วน"], group=G_LINES)
string priceLabelText = input.string("ชื่อ + ราคา", "ข้อความบนป้าย", options=["ชื่อ + ราคา", "ชื่อเท่านั้น", "ราคาเท่านั้น"], group=G_LINES)
color priceLabelTextColor = input.color(color.white, "สีตัวอักษรป้าย (เฉพาะแบบมีกรอบ)", group=G_LINES)
bool showTradeFill = input.bool(true, "แสดงพื้นที่ระหว่างเส้น Entry↔TP/SL", group=G_LINES)
color lossFill = input.color(color.new(color.red, 82), "สีพื้น Entry↔SL", inline="fills", group=G_LINES)
color profitFill = input.color(color.new(color.green, 82), "สีพื้น Entry↔TP", inline="fills", group=G_LINES)
int cleanupTradeAfter = input.int(50, "ลบเส้น TP/SL หลังราคาแตะเป้า/SL แล้วกี่แท่ง (0=ไม่ลบ)", minval=0, group=G_LINES)

string G_BEHAVIOR = "◉ พฤติกรรมโซน"
string zoneSource = input.string("เต็มแท่ง (ไส้ถึงไส้)", "ตีกรอบจาก",
 options=["เต็มแท่ง (ไส้ถึงไส้)", "เนื้อเทียน"], group=G_BEHAVIOR)
string touchMode = input.string("ไส้เทียนแตะ", "นับว่าเข้าโซนเมื่อ", options=["ไส้เทียนแตะ", "ราคาปิดในโซน"], group=G_BEHAVIOR)
string breakMode = input.string("ราคาปิดทะลุ", "นับว่าทะลุโซนเมื่อ", options=["ราคาปิดทะลุ", "ไส้เทียนทะลุ"], group=G_BEHAVIOR)
int touchDelay = input.int(1, "เริ่มนับการเข้าโซนหลังผ่านไปกี่แท่ง", minval=0, group=G_BEHAVIOR)
int retouchCooldown = input.int(20, "เว้นระยะขั้นต่ำระหว่างการเข้าโซนซ้ำ (แท่ง)", minval=0, group=G_BEHAVIOR)
int deleteIfStuck = input.int(100, "ลบโซนถ้าราคาแช่ในโซนติดต่อกันเกิน (แท่ง, 0=ปิด)", minval=0, group=G_BEHAVIOR)
int blockIfStuck = input.int(100, "บล็อกโซนถ้าราคาแช่ในโซนเกิน (แท่ง, 0=ปิด)", minval=0, group=G_BEHAVIOR)
int expireObBars = input.int(194, "ลบโซนหลังเกิดมากี่แท่ง (TF ของ OB, 0=ไม่ลบ)", minval=0, group=G_BEHAVIOR)
int extendZoneBars = input.int(20, "ลากกรอบล้ำไปทางขวา (แท่ง)", minval=0, group=G_BEHAVIOR)
int keepPerSide = input.int(6, "เก็บโซนล่าสุดฝั่งละกี่โซน", minval=1, maxval=20, group=G_BEHAVIOR)
int keepSignalLabels = input.int(3, "เก็บลูกศรสัญญาณล่าสุดกี่อัน", minval=0, maxval=50, group=G_BEHAVIOR)
int nearestZones = input.int(3, "โชว์แค่ N โซนที่ใกล้ราคาสุดต่อฝั่ง (0=โชว์หมด)", minval=0, maxval=20, group=G_BEHAVIOR)
bool showBullZones = input.bool(true, "แสดงโซน Bullish (Demand)", inline="zones", group=G_BEHAVIOR)
bool showBearZones = input.bool(true, "แสดงโซน Bearish (Supply)", inline="zones", group=G_BEHAVIOR)
bool showGrades = input.bool(false, "แสดงป้ายเกรด A/B บนกล่อง", group=G_BEHAVIOR)
bool showGradeA = input.bool(true, "แสดงเกรด A (เข้าทั้ง 2 เกณฑ์)", inline="grades", group=G_BEHAVIOR)
bool showGradeB = input.bool(true, "แสดงเกรด B (เข้าเกณฑ์เดียว)", inline="grades", group=G_BEHAVIOR)

string G_COLORS = "◉ สี"
color bullFill = input.color(color.new(color.teal, 82), "พื้น Bullish", inline="bull", group=G_COLORS)
color bullBorder = input.color(color.teal, "ขอบ", inline="bull", group=G_COLORS)
color bearFill = input.color(color.new(color.red, 84), "พื้น Bearish", inline="bear", group=G_COLORS)
color bearBorder = input.color(color.red, "ขอบ", inline="bear", group=G_COLORS)
