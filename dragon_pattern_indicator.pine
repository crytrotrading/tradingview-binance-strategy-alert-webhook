//@version=6
indicator("Dragon Pattern Reversal [BIG SHOT]", shorttitle="Dragon Pattern", overlay=true, max_lines_count=500, max_labels_count=500)

// ─────────────────────────────────────────────────────────────────────────────
// Settings
// ─────────────────────────────────────────────────────────────────────────────
groupStructure = "1. โครงสร้างมังกร"
leftBars        = input.int(6, "Pivot bars ด้านซ้าย", minval=1, group=groupStructure)
rightBars       = input.int(6, "Pivot bars ด้านขวา", minval=1, group=groupStructure)
requireMajorHead = input.bool(true, "หัวต้องเป็นยอดสูงสุดของ Pivot ที่เก็บไว้", group=groupStructure)
minHeadDrop     = input.float(3.0, "ราคาลงจากหัวขั้นต่ำ (%)", minval=0.0, step=0.1, group=groupStructure) / 100.0
minHeadDropAtr  = input.float(3.0, "ราคาลงจากหัวขั้นต่ำ (ATR)", minval=0.0, step=0.5, group=groupStructure)
minBackRetrace  = input.float(30.0, "หลังต้องเด้งอย่างน้อยของช่วงหัว–ขาหน้า (%)", minval=1.0, maxval=99.0, step=1.0, group=groupStructure) / 100.0
footTolerance   = input.float(5.0, "ระยะห่างขาหน้า–ขาหลังสูงสุด (%)", minval=0.1, step=0.1, group=groupStructure) / 100.0
maxUndercut     = input.float(2.0, "ขาหลังหลุดขาหน้าได้สูงสุด (%)", minval=0.0, step=0.1, group=groupStructure) / 100.0
breakoutAtr     = input.float(0.10, "Breakout buffer (ATR)", minval=0.0, step=0.05, group=groupStructure)
maxWaitBars     = input.int(60, "รอ Breakout ได้ไม่เกิน (แท่ง)", minval=5, group=groupStructure)
cooldownBars    = input.int(40, "เว้นระยะหลังสัญญาณล่าสุด (แท่ง)", minval=0, group=groupStructure)

groupConfirm    = "2. ตัวกรองยืนยัน"
useVolume       = input.bool(false, "ใช้ Volume ยืนยัน", group=groupConfirm)
volumeLength    = input.int(20, "ค่าเฉลี่ย Volume", minval=1, group=groupConfirm)
volumeMultiple  = input.float(1.2, "Volume ต้องมากกว่าค่าเฉลี่ย (เท่า)", minval=0.1, step=0.1, group=groupConfirm)
useTrend        = input.bool(false, "ให้ราคาปิดเหนือ EMA", group=groupConfirm)
emaLength       = input.int(50, "EMA Length", minval=1, group=groupConfirm)

groupRisk       = "3. บริหารความเสี่ยง"
atrLength       = input.int(14, "ATR Length", minval=1, group=groupRisk)
stopAtr         = input.float(0.5, "Stop ใต้ฐาน (ATR)", minval=0.0, step=0.1, group=groupRisk)
riskReward      = input.float(2.0, "Risk : Reward", minval=0.1, step=0.1, group=groupRisk)
projectionBars  = input.int(30, "ระยะเส้น Entry/SL/TP (แท่ง)", minval=5, maxval=500, group=groupRisk)

groupDisplay    = "4. การแสดงผล"
showOnlyLatest  = input.bool(true, "แสดงเฉพาะมังกรตัวล่าสุด", group=groupDisplay)
compactLabels   = input.bool(true, "ป้ายแบบย่อ (รายละเอียดอยู่ใน tooltip)", group=groupDisplay)
showTable       = input.bool(true, "แสดงตารางสถานะ", group=groupDisplay)
showPivotMarks  = input.bool(false, "แสดง Pivot ที่ตรวจพบ", group=groupDisplay)
showEma         = input.bool(false, "แสดง EMA", group=groupDisplay)
highlightSetup  = input.bool(true, "ไฮไลต์เมื่อพบโครงสร้าง", group=groupDisplay)

atr = ta.atr(atrLength)
ema = ta.ema(close, emaLength)
volumeAverage = ta.sma(volume, volumeLength)

plot(showEma ? ema : na, "EMA", color=color.new(color.blue, 20))

// ─────────────────────────────────────────────────────────────────────────────
// Confirmed pivots, kept strictly alternating. A more extreme pivot replaces the
// previous pivot on the same side. Type 1 = high, type -1 = low.
// ─────────────────────────────────────────────────────────────────────────────
pivotHigh = ta.pivothigh(high, leftBars, rightBars)
pivotLow  = ta.pivotlow(low, leftBars, rightBars)

var array<float> pivotPrices = array.new_float()
var array<int>   pivotBars   = array.new_int()
var array<int>   pivotTypes  = array.new_int()

float newPivotPrice = na
int newPivotBar = 0
int newPivotType = 0

if not na(pivotHigh)
    newPivotPrice := pivotHigh
    newPivotBar := bar_index - rightBars
    newPivotType := 1
else if not na(pivotLow)
    newPivotPrice := pivotLow
    newPivotBar := bar_index - rightBars
    newPivotType := -1

bool pivotsChanged = false
if newPivotType != 0
    int pivotCount = array.size(pivotTypes)
    if pivotCount == 0
        array.push(pivotPrices, newPivotPrice)
        array.push(pivotBars, newPivotBar)
        array.push(pivotTypes, newPivotType)
        pivotsChanged := true
    else
        int lastIndex = pivotCount - 1
        int lastType = array.get(pivotTypes, lastIndex)
        float lastPrice = array.get(pivotPrices, lastIndex)
        if newPivotType == lastType
            bool isMoreExtreme = newPivotType == 1 ? newPivotPrice > lastPrice : newPivotPrice < lastPrice
            if isMoreExtreme
                array.set(pivotPrices, lastIndex, newPivotPrice)
                array.set(pivotBars, lastIndex, newPivotBar)
                pivotsChanged := true
        else
            array.push(pivotPrices, newPivotPrice)
            array.push(pivotBars, newPivotBar)
            array.push(pivotTypes, newPivotType)
            pivotsChanged := true
            if array.size(pivotTypes) > 14
                array.shift(pivotPrices)
                array.shift(pivotBars)
                array.shift(pivotTypes)

plotshape(showPivotMarks and not na(pivotHigh), "Pivot High", shape.triangledown, location.abovebar, color=color.new(color.red, 40), size=size.tiny, offset=-rightBars)
plotshape(showPivotMarks and not na(pivotLow), "Pivot Low", shape.triangleup, location.belowbar, color=color.new(color.lime, 40), size=size.tiny, offset=-rightBars)

// ─────────────────────────────────────────────────────────────────────────────
// Candidate structure: Head (H) → Front foot (L) → Back (H) → Rear foot (L).
// The buy signal only fires once price closes above the back of the dragon.
// ─────────────────────────────────────────────────────────────────────────────
var bool  candidateActive = false
var float candidateBack = na
var float candidateBase = na
var int   candidateRearBar = -1
var int   candidateBornBar = -1
var int   lastSignalBar = -1

var line neckLine = na
var line frontToBackLine = na
var line backToRearLine = na
var line resistanceLine = na
var label headLabel = na
var label neckLabel = na
var label frontLabel = na
var label backLabel = na
var label rearLabel = na

// Drawings of dragons that already broke out. Cleared when a newer dragon
// confirms and "show only latest" is enabled.
var array<line>  historyLines  = array.new<line>()
var array<label> historyLabels = array.new<label>()

bool cooldownOver = lastSignalBar < 0 or bar_index - lastSignalBar >= cooldownBars

if pivotsChanged and cooldownOver and array.size(pivotTypes) >= 4
    int count = array.size(pivotTypes)
    int iRear = count - 1
    int iBack = count - 2
    int iFront = count - 3

    bool shapeOk = array.get(pivotTypes, iRear) == -1 and array.get(pivotTypes, iBack) == 1 and array.get(pivotTypes, iFront) == -1

    if shapeOk
        float rearPrice = array.get(pivotPrices, iRear)
        float backPrice = array.get(pivotPrices, iBack)
        float frontPrice = array.get(pivotPrices, iFront)
        int rearBar = array.get(pivotBars, iRear)
        int backBar = array.get(pivotBars, iBack)
        int frontBar = array.get(pivotBars, iFront)

        // The head is the highest pivot high before the front foot, and it must
        // stay above the back so the dragon keeps its lower-high shape.
        int headIndex = -1
        float headPrice = na
        for i = 0 to iFront - 1
            if array.get(pivotTypes, i) == 1
                float possibleHead = array.get(pivotPrices, i)
                if possibleHead > backPrice and (headIndex == -1 or possibleHead > headPrice)
                    headIndex := i
                    headPrice := possibleHead

        // A fresh dragon must start after the previous signal so overlapping
        // structures inside the same consolidation are not counted again.
        bool freshStructure = frontBar > lastSignalBar

        if headIndex >= 0 and freshStructure
            int headBar = array.get(pivotBars, headIndex)
            float headToFront = headPrice - frontPrice
            float feetDistance = math.abs(rearPrice - frontPrice) / frontPrice
            bool majorHead = not requireMajorHead or headPrice >= array.max(pivotPrices)
            bool deepEnoughDrop = headToFront > 0 and headToFront >= headPrice * minHeadDrop and headToFront >= atr * minHeadDropAtr
            bool validBackBounce = backPrice >= frontPrice + headToFront * minBackRetrace
            bool validFeet = feetDistance <= footTolerance and rearPrice >= frontPrice * (1.0 - maxUndercut)

            if majorHead and deepEnoughDrop and validBackBounce and validFeet and rearBar != candidateRearBar
                line.delete(neckLine)
                line.delete(frontToBackLine)
                line.delete(backToRearLine)
                line.delete(resistanceLine)
                label.delete(headLabel)
                label.delete(neckLabel)
                label.delete(frontLabel)
                label.delete(backLabel)
                label.delete(rearLabel)

                candidateActive := true
                candidateBack := backPrice
                candidateBase := math.min(frontPrice, rearPrice)
                candidateRearBar := rearBar
                candidateBornBar := bar_index

                neckLine := line.new(headBar, headPrice, frontBar, frontPrice, color=color.orange, width=2)
                frontToBackLine := line.new(frontBar, frontPrice, backBar, backPrice, color=color.orange, width=2)
                backToRearLine := line.new(backBar, backPrice, rearBar, rearPrice, color=color.orange, width=2)
                resistanceLine := line.new(backBar, backPrice, bar_index, backPrice, extend=extend.right, color=color.new(color.red, 10), style=line.style_dashed, width=2)

                headLabel := label.new(headBar, headPrice, "หัว", style=label.style_label_down, color=color.red, textcolor=color.white, size=size.small)
                frontLabel := label.new(frontBar, frontPrice, "ขาหน้า", style=label.style_label_up, color=color.green, textcolor=color.white, size=size.small)
                backLabel := label.new(backBar, backPrice, "หลัง", style=label.style_label_down, color=color.orange, textcolor=color.white, size=size.small)
                rearLabel := label.new(rearBar, rearPrice, "ขาหลัง", style=label.style_label_up, color=color.green, textcolor=color.white, size=size.small)
                if not compactLabels
                    neckLabel := label.new(int(math.avg(headBar, frontBar)), math.avg(headPrice, frontPrice), "คอ", style=label.style_label_left, color=color.new(color.orange, 15), textcolor=color.white, size=size.small)

float stopPrice = candidateActive ? candidateBase - atr * stopAtr : na
bool setupBroken = candidateActive and close < stopPrice
bool setupExpired = candidateActive and not setupBroken and bar_index - candidateBornBar > maxWaitBars

if setupBroken or setupExpired
    candidateActive := false
    line.delete(neckLine)
    line.delete(frontToBackLine)
    line.delete(backToRearLine)
    line.delete(resistanceLine)
    label.delete(headLabel)
    label.delete(neckLabel)
    label.delete(frontLabel)
    label.delete(backLabel)
    label.delete(rearLabel)

bool priceBreakout = candidateActive and close > candidateBack + atr * breakoutAtr
bool volumeConfirmed = not useVolume or na(volume) or na(volumeAverage) or volume > volumeAverage * volumeMultiple
bool trendConfirmed = not useTrend or close > ema
bool dragonBreakout = priceBreakout and volumeConfirmed and trendConfirmed

if dragonBreakout
    float entryPrice = close
    float risk = entryPrice - stopPrice
    float targetPrice = entryPrice + risk * riskReward
    string levelsText = "Entry " + str.tostring(entryPrice, format.mintick) + "\nSL " + str.tostring(stopPrice, format.mintick) + "\nTP " + str.tostring(targetPrice, format.mintick)

    if showOnlyLatest
        for oldLine in historyLines
            line.delete(oldLine)
        for oldLabel in historyLabels
            label.delete(oldLabel)
        array.clear(historyLines)
        array.clear(historyLabels)

    if not na(resistanceLine)
        line.set_x2(resistanceLine, bar_index)
        line.set_extend(resistanceLine, extend.none)

    array.push(historyLines, line.new(bar_index, entryPrice, bar_index + projectionBars, entryPrice, color=color.blue, width=2))
    array.push(historyLines, line.new(bar_index, stopPrice, bar_index + projectionBars, stopPrice, color=color.red, width=2))
    array.push(historyLines, line.new(bar_index, targetPrice, bar_index + projectionBars, targetPrice, color=color.lime, width=2))
    if compactLabels
        array.push(historyLabels, label.new(bar_index, high, "หาง BUY", style=label.style_label_down, color=color.lime, textcolor=color.black, size=size.small, tooltip=levelsText))
    else
        array.push(historyLabels, label.new(bar_index, high, "หาง / BUY\n" + levelsText, style=label.style_label_down, color=color.lime, textcolor=color.black, size=size.small))

    // Hand the anatomy drawings over to history so they survive on the chart.
    array.push(historyLines, neckLine)
    array.push(historyLines, frontToBackLine)
    array.push(historyLines, backToRearLine)
    array.push(historyLines, resistanceLine)
    array.push(historyLabels, headLabel)
    array.push(historyLabels, frontLabel)
    array.push(historyLabels, backLabel)
    array.push(historyLabels, rearLabel)
    if not na(neckLabel)
        array.push(historyLabels, neckLabel)

    neckLine := na
    frontToBackLine := na
    backToRearLine := na
    resistanceLine := na
    headLabel := na
    neckLabel := na
    frontLabel := na
    backLabel := na
    rearLabel := na

    candidateActive := false
    lastSignalBar := bar_index

bgcolor(highlightSetup and candidateActive ? color.new(color.orange, 90) : na, title="Dragon setup active")
plotshape(dragonBreakout, title="Dragon breakout", style=shape.triangleup, location=location.belowbar, color=color.lime, size=size.small)
plotshape(setupBroken, title="Dragon invalidated", style=shape.xcross, location=location.belowbar, color=color.red, size=size.tiny)

// ─────────────────────────────────────────────────────────────────────────────
// Status panel, so the chart always shows what the indicator currently sees.
// ─────────────────────────────────────────────────────────────────────────────
var table statusTable = table.new(position.top_right, 2, 5, bgcolor=color.new(color.black, 20), border_color=color.new(color.gray, 50), border_width=1)

if showTable and barstate.islast
    string stateText = candidateActive ? "พบโครงสร้าง รอเบรกแนวต้าน" : cooldownOver ? "ยังไม่พบโครงสร้างมังกร" : "พักหลังสัญญาณล่าสุด"
    color stateColor = candidateActive ? color.orange : color.silver
    string resistanceText = candidateActive ? str.tostring(candidateBack, format.mintick) : "-"
    string baseText = candidateActive ? str.tostring(candidateBase, format.mintick) : "-"
    string signalText = lastSignalBar >= 0 ? str.tostring(bar_index - lastSignalBar) + " แท่งก่อน" : "ยังไม่มี"
    string pivotText = str.tostring(array.size(pivotTypes)) + " จุด"

    table.cell(statusTable, 0, 0, "🐉 Dragon Pattern", text_color=color.white, text_size=size.small, text_halign=text.align_left)
    table.cell(statusTable, 1, 0, timeframe.period, text_color=color.white, text_size=size.small, text_halign=text.align_right)
    table.cell(statusTable, 0, 1, "สถานะ", text_color=color.gray, text_size=size.small, text_halign=text.align_left)
    table.cell(statusTable, 1, 1, stateText, text_color=stateColor, text_size=size.small, text_halign=text.align_right)
    table.cell(statusTable, 0, 2, "แนวต้าน (หลัง)", text_color=color.gray, text_size=size.small, text_halign=text.align_left)
    table.cell(statusTable, 1, 2, resistanceText, text_color=color.red, text_size=size.small, text_halign=text.align_right)
    table.cell(statusTable, 0, 3, "ฐาน (ขาหน้า/ขาหลัง)", text_color=color.gray, text_size=size.small, text_halign=text.align_left)
    table.cell(statusTable, 1, 3, baseText, text_color=color.lime, text_size=size.small, text_halign=text.align_right)
    table.cell(statusTable, 0, 4, "Pivot / สัญญาณล่าสุด", text_color=color.gray, text_size=size.small, text_halign=text.align_left)
    table.cell(statusTable, 1, 4, pivotText + " / " + signalText, text_color=color.aqua, text_size=size.small, text_halign=text.align_right)

alertcondition(dragonBreakout, title="Dragon Pattern Breakout", message="Dragon bullish reversal confirmed on {{ticker}} {{interval}}. Close: {{close}}, Volume: {{volume}}")
alertcondition(setupBroken, title="Dragon Pattern Invalidated", message="Dragon setup invalidated on {{ticker}} {{interval}}. Close: {{close}}")
