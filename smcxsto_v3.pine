color bullBbBorder = input.color(color.blue, "ขอบ", inline="bullbb", group=G_COLORS)
color bearBbFill = input.color(color.new(color.orange, 82), "พื้น Bear BB", inline="bearbb", group=G_COLORS)
color bearBbBorder = input.color(color.orange, "ขอบ", inline="bearbb", group=G_COLORS)

string G_TABLE = "◉ ตาราง CHECKLIST"
bool showChecklist = input.bool(true, "แสดงตาราง checklist", group=G_TABLE)
string tablePosition = input.string("ล่างขวา", "ตำแหน่งตาราง",
 options=["บนซ้าย", "บนขวา", "ล่างซ้าย", "ล่างขวา"], group=G_TABLE)
string tableTextSize = input.string("เล็ก", "ขนาดตัวอักษร", options=["จิ๋ว", "เล็ก", "ปกติ"], group=G_TABLE)
bool showDebug = input.bool(false, "แถว DEBUG (ดูว่ารอคอนดิชันไหนบ้าง)", group=G_TABLE)
